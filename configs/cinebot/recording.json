{
  "schema_version": 1,
  "phone": {
    "role": "frame_of_record",
    "capture_strategy": "record_master_on_phone_and_stream_preview_to_host",
    "preview_transport": "webrtc_or_mjpeg_to_be_selected",
    "preview_url": null,
    "target_resolution": [1920, 1080],
    "target_fps": 30,
    "lock_focus_during_take": true,
    "lock_exposure_during_take": true,
    "lock_white_balance_during_take": true
  },
  "director_camera": {
    "role": "global_geometry_and_tracking",
    "type": "opencv",
    "index_or_path": null,
    "target_resolution": [1280, 720],
    "target_fps": 30
  },
  "synchronization": {
    "host_clock": "monotonic_ns",
    "required_streams": [
      "phone_preview",
      "director_video",
      "phone_joint_state",
      "phone_joint_command",
      "light_joint_state",
      "light_joint_command",
      "shot_intent",
      "recording_cues"
    ],
    "take_start_marker": "visible_flash_or_clap_plus_host_timestamp"
  },
  "dataset": {
    "format": "LeRobotDataset_v3",
    "fps": 30,
    "starter_evaluation_takes_per_skill": 10,
    "starter_learning_episodes_per_failure_case": 50,
    "split_by_take_or_setup": true
  }
}
