# Preserve imported source, measurements and calibration bytes in Git.
/lerobot/** -text
/archive/** -text
/data/** -text
/calibration/** -text
/assets/robots/reference/** -text

# Large, immutable recovery snapshots use Git LFS.
/archive/recovery/**/workspace.zip filter=lfs diff=lfs merge=lfs -text

# Editor source media and generated video derivatives are large binary assets.
/data/editor/**/*.mp4 filter=lfs diff=lfs merge=lfs -text

# Preserve and hydrate the upstream LeRobot LFS test artifacts.
/lerobot/tests/artifacts/cameras/image_128x128.png filter=lfs diff=lfs merge=lfs -text
/lerobot/tests/artifacts/cameras/image_160x120.png filter=lfs diff=lfs merge=lfs -text
