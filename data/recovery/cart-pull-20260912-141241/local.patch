+            "/api/director/creative",
+            {
+                **self.envelope(),
+                "scope": asdict(session.scope()),
+                "action": "load_sample",
+                "payload": {"skill_id": "reaction"},
+            },
+        )
+        self.assertEqual(status, 200)
